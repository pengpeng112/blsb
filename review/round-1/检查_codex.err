from .his_medrec import MedrecHisConnector
from .pis_pitaya import PitayaPisConnector
from .warehouse import (OracleWarehouse, SqlServerWarehouse, SyntheticWarehouse,
                        TEMPLATES, render_sql)

__all__ = ["PitayaPisConnector", "MedrecHisConnector", "SyntheticWarehouse",
           "SqlServerWarehouse", "OracleWarehouse", "TEMPLATES", "render_sql"]

"""连接器SDK（02 §6、10 §1—§2）。

插件不持有任意SQL执行权限；对象名走允许列表；查询值全部参数绑定。
"""
from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Protocol


@dataclass
class SourceScope:
    """已批准的读取作用域（10 §2.1）：锁定来源系统、库、schema、命名空间版本。"""
    tenant_id: str
    source_system_code: str
    database: str | None = None
    schema: str | None = None
    namespace: str = ""
    namespace_version: str = "1"

    def object_ref(self, obj: str) -> str:
        parts = [self.database, self.schema, obj]
        return ".".join(p for p in parts if p)


@dataclass
class SlideCandidate:
    source_object: str
    source_key: str          # Pitaya_Slice.Id 原值字符串
    barcode_raw: str         # qptmh 原值
    pathology_no: str        # PathologyID 原值
    block_key: str | None    # lkh 原值
    status_raw: dict = field(default_factory=dict)  # qpzt/zpzt/tmdyzt 原值，不解释
    observed_at: str = ""
    raw_digest: str = ""
    evidence_level: str = "SOURCE_RECORD"


@dataclass
class CaseRecord:
    source_object: str
    source_key: str
    pathology_no: str
    patient_source_id: str | None
    in_patient_id: str | None
    out_patient_id: str | None
    req_note_id: str | None
    identity_card: str | None
    name_masked: str | None
    create_time: str | None
    application_time: str | None      # 权威申请时间字段；未确认时为 None
    spec_recv_time: str | None
    report_time: str | None
    verify_report_time: str | None
    status_raw: str | None
    category_raw: str | None
    raw: dict = field(default_factory=dict)


@dataclass
class ApplicationCandidate:
    source_object: str
    source_key: str
    external_id: str
    requested_at: str | None
    encounter_kind_raw: str | None    # 病人类型原值（如'住院'/'门诊'）
    category_raw: str | None
    request_org_raw: str | None
    status_raw: str | None
    void_info: dict = field(default_factory=dict)
    raw: dict = field(default_factory=dict)


@dataclass
class ReportRecord:
    source_object: str
    source_key: str
    pathology_no: str
    report_serial: str
    gross: str | None
    microscopic: str | None
    diagnosis: str | None
    issued_at: str | None
    audit_time: str | None
    report_org_raw: str | None
    image_url: str | None
    voided: bool = False
    raw: dict = field(default_factory=dict)


@dataclass
class PatientCandidate:
    source_object: str
    source_key: str
    patient_id: str
    id_type_raw: str | None
    id_no_masked: str | None
    id_no_full_ref: str | None   # 敏感值不经API明文传递；指向证据对象
    name_masked: str | None
    birth_date: str | None
    gender_raw: str | None


@dataclass
class EncounterCandidate:
    source_object: str
    source_key: str
    patient_id: str
    visit_id: str
    kind: str  # inpatient / outpatient / special_outpatient（来源证实后填写）
    raw: dict = field(default_factory=dict)


class Warehouse(Protocol):
    """方言数据访问抽象：适配器只通过本协议取数。"""

    def fetch_all(self, template_id: str, params: dict, limit: int) -> list[dict]: ...
    def dialect(self) -> str: ...


class SourceConnector(Protocol):
    plugin_id: str

    def validate_config(self, config: dict) -> list[str]: ...
    def test_connection(self, config: dict) -> dict: ...


class CapabilityError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


def capability_unsupported(message: str) -> CapabilityError:
    return CapabilityError("CAPABILITY_UNSUPPORTED", message)


def driver_unavailable(driver: str, detail: str = "") -> CapabilityError:
    return CapabilityError("DRIVER_UNAVAILABLE",
                           f"driver {driver} not installed/configured: {detail}")

# 外部阻断清单

更新：2026-09-30。对应设计09 §3 B01—B09；控制台同步展示（`GET /api/v1/external-blockers`，
种子写入 `apps/seed.py::BLOCKERS`）。每项缺一个字段只阻断受影响的索引/包/目的地，
不阻断存储链路与本地MVP。

| 编号 | 事项 | 责任方 | 只阻断什么 | 当前状态 | 实现侧落点 |
|---|---|---|---|---|---|
| B01 | PIS 库 PITAYA/QPIS、表/view 授权、SQL 版本未确认 | PIS厂商/DBA | 首院生产连接（不阻断Mock与驱动实现） | OPEN | `warehouse.SqlServerWarehouse` DSN 未配置时 DRIVER_UNAVAILABLE；合成仓储合同测试已通过 |
| B02 | 条码内容/大小写/前导零/复用范围未确认 | PIS/扫描厂商 | 无歧义自动绑定与真机采集 | OPEN | 反查返回数组（0/1/N）；F03/F04 已按歧义处理实现 |
| B03 | 申请时间权威字段未确认 | PIS | 正式索引段6 | OPEN | `requested_at_source` 空或非批准字段→QF-TIME-SEMANTICS 等待 |
| B04 | 申请类别/状态/齐套/补片/撤销规则未确认 | PIS/病理科 | 临床自动就绪与索引段8 | OPEN | '--'→QF-CATEGORY 等待；状态值域未批准→QF-STATUS 不判齐套 |
| B05 | HIS 证件字典、门诊/慢特病就诊路径未确认 | HIS | 身份/就诊自动关联 | OPEN | 门诊返回能力缺失；住院需 PATIENT_ID+VISIT_ID 精确命中 |
| B06 | 各报告机构有效医保代码未取得 | 医保/院方 | 正式索引段7 | OPEN | 库内 YYDM/YLV21051 不采信；等待批准映射 |
| B07 | 更新/物理删除/报告版本/父子键未确认 | PIS/DBA | 宣称增量无漏数及自动更正 | OPEN | 已实现分区内容盘点兜底（F14/F15）；不产生自动墓碑 |
| B08 | 扫描格式/目录/scan_id/完成信号未答复 | 扫描厂商（迪英加） | 生产扫描自动完成判断 | OPEN | vendor_manifest 模式已实现并验证；目录模式仅候选+人工放行 |
| B09 | 正式病理医保协议/鉴权/更正/回执未发布 | 医保 | 真实医保生产发送 | OPEN | 仅 Mock 平台（显著标注）；未实现任何真实协议 |

## 取得证据后的解锁路径

- B01：配置 `BLYB_PIS_SQLSERVER_DSN` → 运行 `tests/integration/test_real_drivers.py::test_sqlserver_live`（有DSN才执行）。
- B05：医院批准桥接/字典 → 写入 HospitalPack `pis_visit_bridge` / `approved_dictionaries` 并发布（review-draft 默认不含）。
- B08：厂商接口确认后按 `设计交付v0.4/06` 验收真机用例；Dir 模式排除规则按设备Profile配置。
- B09：正式协议发布后新增 DestinationProfile 插件；Mock 通过不得自动打开生产 Profile（代码已强制 is_mock 分离）。


## 整改第2轮备注（2026-10-01）

本轮未连接任何真实系统，B01—B09 阻断状态不变。与阻断相关的实现变化：

- B05（门诊/慢特病路径、身份字典）：encounter_kind demo-v2 仅含 门诊=1/住院=2；**慢特病=3 的编码为 S03 正式规则，但门诊/慢特病就诊路径本身仍属 B05 未确认**，故暂不增补源值映射，路径确认后以新字典版本增补。
- B06（报告机构医保码）：索引段7 已改为报告机构来源（R32）；YLV21051→H1234567890X 仍为合成映射，正式码取得前不替换。
- B09（医保回执语义）：ACCEPTED≠CONFIRMED 已按传输受理/业务确认分离（R01/R02）；真实平台回执字段语义仍待 B09。
- 生产守卫（W10骨架）：所有真实目的地发送/发布入口在 B01—B09 任一 OPEN 时拒绝；Mock 目的地不受影响。


