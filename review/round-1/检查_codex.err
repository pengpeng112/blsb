def _node(nid, ntype, plugin_key, params=None):
    return {"id": nid, "type": ntype, "plugin_ref": {"key": plugin_key, "version": "1.0"},
            "parameters": params or {}, "timeout_seconds": 300,
            "retry": {"max_attempts": 3, "initial_delay_seconds": 1,
                      "max_delay_seconds": 30}}


def pathology_push_workflow() -> dict:
    return {
        "workflow_key": "pathology.mock_push", "revision": 1,
        "trigger": "acquisition_files_complete", "production_enabled": False,
        "nodes": [
            _node("resolve", "resolve", "pathology.resolve", {"strategy": "pis_barcode_lookup"}),
            _node("quality", "validate", "pathology.quality", {"ruleset_ref": "hospital-demo-quality-v1"}),
            _node("ready", "wait_dependencies", "pathology.completeness", {"policy": "whole_case"}),
            _node("freeze", "package.freeze", "core.package"),
            _node("map", "target.map", "profile.pathology_internal_v1"),
            _node("validate", "target.validate", "core.schema"),
            _node("send", "deliver.push", "destination.mock_http",
                  {"destination_ref": "mock-only"}),
            _node("receipt", "receipt.wait", "destination.mock_http"),
        ],
        "edges": [
            {"from": "resolve", "to": "quality", "on": "success"},
            {"from": "quality", "to": "ready", "on": "success"},
            {"from": "ready", "to": "freeze", "on": "success"},
            {"from": "freeze", "to": "map", "on": "success"},
            {"from": "map", "to": "validate", "on": "success"},
            {"from": "validate", "to": "send", "on": "success"},
            {"from": "send", "to": "receipt", "on": "success"},
        ],
    }


def pathology_publish_workflow() -> dict:
    return {
        "workflow_key": "pathology.mock_publish", "revision": 1,
        "trigger": "package_frozen", "production_enabled": False,
        "nodes": [
            _node("freeze", "package.freeze", "core.package"),
            _node("publish", "deliver.publish", "destination.view_publication"),
        ],
        "edges": [{"from": "freeze", "to": "publish", "on": "success"}],
    }


def metrics_push_workflow() -> dict:
    return {
        "workflow_key": "metrics.mock_push", "revision": 1,
        "trigger": "package_changed", "production_enabled": False,
        "nodes": [
            _node("freeze", "package.freeze", "metrics.package"),
            _node("map", "target.map", "profile.metrics_json"),
            _node("validate", "target.validate", "core.schema"),
            _node("send", "deliver.push", "destination.mock_http"),
            _node("receipt", "receipt.wait", "destination.mock_http"),
        ],
        "edges": [
            {"from": "freeze", "to": "map", "on": "success"},
            {"from": "map", "to": "validate", "on": "success"},
            {"from": "validate", "to": "send", "on": "success"},
            {"from": "send", "to": "receipt", "on": "success"},
        ],
    }


def resolve_volume_root(default_name: str) -> str:
    """对象卷根。BLYB_VOLUME_ROOT 仅供全量 seed；未设置时仍是 implementation/var/<name>。"""
    override = os.environ.get("BLYB_VOLUME_ROOT", "").strip()
    if override:
        return os.path.abspath(override)
    return os.path.join(HERE, "var", default_name)


def _place_primary_volume(db, tenant_id: str, vol_root: str) -> None:
    """登记或对齐 vol1。无对象位置时允许改根；已有位置时拒绝，避免库和文件分家。"""
"""通用插件装配中心（W11）：manifest 驱动，核心不再硬编码领域。

- 每个领域插件提供 plugin.py::register(reg)，登记节点处理器、编号迁移
  与领域能力（如病理 Runtime 构建）。
- 核心保持通用概念（Task/Package/Asset/Submission/Publication）；worker 与
  core_api 通过 PluginRegistry.handler_for 解析，未知 plugin_key 无回退（R19）。
- BLYB_PLUGINS 环境变量选择启用集（逗号分隔，默认全量）；metrics-only
  进程设 BLYB_PLUGINS=metrics 即完全不加载病理模块。
"""
from __future__ import annotations

import importlib
import os

PLUGIN_MANIFESTS: dict[str, dict] = {
    "pathology": {
        "module": "domains.pathology.plugin",
        "domain": "pathology",
        "capabilities": ["resolve", "quality", "completeness", "freeze",
                         "runtime_build"],
        "description": "病理切片归集/关联/索引/冻结领域插件",
    },
    "metrics": {
        "module": "domains.metrics.plugin",
        "domain": "metrics",
        "capabilities": ["csv_import", "freeze", "map"],
        "description": "运营指标CSV月报领域插件（无患者字段）",
    },
}


class PluginRegistry:
    """已加载插件集合：处理器表 + 迁移 + 领域能力附件。"""

    def __init__(self):
        self.handlers: dict[tuple[str, str], object] = {}
        self.migrations: list = []
        self.enabled: list[str] = []
        self._attached: dict[str, object] = {}

    def add_handlers(self, entries: dict[tuple[str, str], object]) -> None:
        self.handlers.update(entries)

    def add_migration(self, migration) -> None:
        self.migrations.append(migration)

    def attach(self, key: str, value) -> None:
        self._attached[key] = value

    def capability(self, key: str):
        return self._attached.get(key)

    def has(self, plugin_key: str) -> bool:
        return plugin_key in self.enabled

    def handler_for(self, node_type: str, plugin_key: str):
        """严格查找（R19）：未注册返回 None，由 engine 报 CAPABILITY_UNSUPPORTED。"""
        return self.handlers.get((node_type, plugin_key))

    def build_runtime(self, db, tenant_id: str, **kw):
        fn = self.capability("pathology.build_runtime")
        if fn is None:
            from connector_sdk import CapabilityError
            raise CapabilityError(
                "CAPABILITY_UNSUPPORTED",
                "pathology plugin not enabled in this process")
        return fn(db, tenant_id, **kw)


def enabled_plugins() -> list[str]:
    env = os.environ.get("BLYB_PLUGINS", "")
    if not env:
        return list(PLUGIN_MANIFESTS)
    keys = [k.strip() for k in env.split(",") if k.strip()]
    unknown = [k for k in keys if k not in PLUGIN_MANIFESTS]
    if unknown:
        raise RuntimeError(
            f"unknown plugin(s) in BLYB_PLUGINS: {unknown}; "
            f"available: {sorted(PLUGIN_MANIFESTS)}")
    return keys


def load_registry(keys: list[str] | None = None) -> PluginRegistry:
    reg = PluginRegistry()
    # 基线通用处理器（核心概念：目标映射/校验/投递/回执/发布）——任何领域可用
    from core_handlers import (h_deliver_publish, h_deliver_push, h_receipt_wait,
                               h_target_map, h_target_validate)
    reg.add_handlers({
        ("target.map", "core.mapping"): h_target_map,
        ("target.map", "profile.pathology_internal_v1"): h_target_map,
        ("target.validate", "core.schema"): h_target_validate,
        ("deliver.push", "destination.mock_http"): h_deliver_push,
        ("receipt.wait", "destination.mock_http"): h_receipt_wait,
        ("deliver.publish", "destination.view_publication"): h_deliver_publish,
    })
    for key in (enabled_plugins() if keys is None else keys):
        manifest = PLUGIN_MANIFESTS.get(key)
        if manifest is None:
            raise RuntimeError(f"unknown plugin key: {key}")
        mod = importlib.import_module(manifest["module"])
        mod.register(reg)
        reg.enabled.append(key)
    return reg


