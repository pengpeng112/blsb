    def _j_poll_receipts(self, db, job: Job):
        sub = db.query(Submission).get(job.payload["submission_id"])
        if sub is None:
            return
        from contracts import SubmissionState
        receipts = self._poll_mock_receipts()
        matched = [r for r in receipts
                   if r.get("submission_key") == sub.idempotency_key]
        for r in matched:
            self.registry.store_receipt(db, sub.tenant_id, sub.destination_id, r, sub.id)
        db.commit()
        if not matched and sub.state != SubmissionState.CONFIRMED:
            # 无回执：保持待确认，但指数退避（1s→2s→…封顶60s），避免打爆真实平台。
            # 重排必须开新作业行（dedup加代次后缀）：复用原键会被 enqueue 去重
            # 提前返回（payload 不更新、poll_count 不递增），且本作业稍后会被
            # finish_job 置 SUCCEEDED，复用同一行会让轮询链就此中断。
            poll_count = int((job.payload or {}).get("poll_count", 0)) + 1
            delay = min(60, 2 ** min(poll_count - 1, 6))
            self.registry.enqueue(
                db, sub.tenant_id, "destination.poll_receipts",
                f"{sub.id}#poll{poll_count}",
                {"submission_id": sub.id, "poll_count": poll_count},
                delay_seconds=delay)

    def _j_query_unknown(self, db, job: Job):
        sub = db.query(Submission).get(job.payload["submission_id"])
        if sub is None:
            return
        result = self._query_mock(sub.idempotency_key)
        if result.get("found") and result.get("accepted"):
            sub.state = "ACCEPTED"
            db.commit()
        elif result.get("found") is False:
            # 远端无记录：同一幂等键重发（非新建业务提交）
            self.registry.enqueue(db, sub.tenant_id, "workflow.launch",
                                  f"push2:{sub.package_revision_id}",
                                  {"package_revision_id": sub.package_revision_id,
                                   "case_id": job.payload.get("case_id")})

    def _j_metrics_run(self, db, job: Job):
        pkg_rows = job.payload.get("rows")
        # 优先双目标工作流（G23）；旧库只有单目标时回退
        dual = (db.query(WorkflowRevision)
                .filter_by(tenant_id=job.tenant_id, workflow_key="metrics.dual_mock",
                           status="PUBLISHED").first())
        key = "metrics.dual_mock" if dual is not None else "metrics.mock_push"
        self._launch(db, job.tenant_id, key,
                     {"package_id": job.payload["package_id"], "rows": pkg_rows})

    def _j_pis_poll(self, db, job: Job):
        rt = self.registry.build_runtime(db, job.tenant_id)
        cp = (db.query(SourceCheckpoint)
              .filter_by(tenant_id=job.tenant_id,
                         connector_id=job.payload.get("connector_id", ""),
                         stream="pis.created", partition="0").first())
        cursor = dict(cp.cursor_json or {}) if cp is not None else {
            "since": "0000-01-01T00:00:00"}
        cursor["until"] = "9999-12-31T23:59:59"
        # poll_changes 原地推进 (CreateTime, PathologyID) 复合游标（R11）
        rows = rt.pis.poll_changes(rt.scope(), "cases", cursor, 50)
        for r in rows:
            jobs_mod.emit(db, job.tenant_id, f"pis:case:{r['source_key']}",
                          "pis.source_changed", {"pathology_no": r["source_key"]})
        new_cursor = {"since": cursor.get("since", "0000-01-01T00:00:00"),
                      "since_key": cursor.get("since_key", "")}
        if cp is None:
            db.add(SourceCheckpoint(
                id=new_uuid(), tenant_id=job.tenant_id,
                connector_id=job.payload.get("connector_id", ""),
                stream="pis.created", partition="0", cursor_json=new_cursor))
        else:
            cp.cursor_json = new_cursor
            cp.row_version += 1
        # 游标推进与事件在同一事务提交（R11：checkpoint与本页Inbox/Outbox原子）
        db.commit()

    def _j_pis_partition(self, db, job: Job):
        from core_db.models import (SourceRecord, SourceRecordRevision,
                                    SourceReconciliationPartition,
                                    SourceReconciliationRun)
        rt = self.registry.build_runtime(db, job.tenant_id)


def _store_receipt(db, tenant_id, destination_id, raw: dict, submission_id: str | None,
                   publication_id: str | None = None):
    existing = (db.query(ReceiptEvent)
                .filter_by(tenant_id=tenant_id, destination_id=destination_id,
                           external_receipt_id=raw.get("receipt_id", "")).first())
    if existing is not None:
        return existing  # 幂等；旧回执不回退新版本
    ev = ReceiptEvent(
        id=new_uuid(), tenant_id=tenant_id, destination_id=destination_id,
        external_receipt_id=raw.get("receipt_id", f"digest:{digest_of(raw)[:16]}"),
        submission_ref=submission_id, publication_ref=publication_id,
        raw_payload=raw,
        parsed_result={"result": raw.get("result"), "seq": raw.get("seq")})
    db.add(ev)
    if submission_id:
        sub = db.query(Submission).get(submission_id)
        if sub is not None:
            # R01：ACCEPTED=传输受理，不推进业务确认；只有 CONFIRMED 才是目标业务成功
            if raw.get("result") == "CONFIRMED":
                apply_business_confirmation(db, tenant_id, submission_id)
            elif raw.get("result") == "ACCEPTED":
                sub.state = SubmissionState.ACCEPTED
            # UNKNOWN/PARTIAL/REJECTED 不改写状态，留待逐项对账
    db.flush()
    return ev


def apply_business_confirmation(db, tenant_id: str, submission_id: str) -> bool:
    """CONFIRMED 回执的业务落地（功能测试发现的跨入口不一致修复）。

    三个回执入口（worker轮询、core API、交换网关）必须产生一致的业务状态：
    submission→CONFIRMED 且病例 target_confirmed=True。幂等；REJECTED 后的
    迟到/矛盾 CONFIRMED 不倒退状态（回执事件本身仍保留供对账）。
    """
    sub = db.query(Submission).get(submission_id)
    if sub is None or sub.tenant_id != tenant_id:
        return False
    if sub.state == SubmissionState.CONFIRMED:
        return True
    if sub.state == SubmissionState.REJECTED:
        return False
    sub.state = SubmissionState.CONFIRMED
    # 目标业务确认 → 病例分列状态（区别于文件落盘/玻片关联/临床就绪）
    pr = db.query(PackageRevision).get(sub.package_revision_id)
    case_id = (pr.provenance or {}).get("case_id") if pr else None
    if case_id:
        try:
            from domains.pathology.models import PathologyCase
            case = db.query(PathologyCase).get(case_id)
            if case is not None:
                case.target_confirmed = True
        except ImportError:
            pass  # metrics-only：无病理领域，忽略病例分列
    return True


def h_deliver_publish(ctx: HandlerCtx) -> StepOutcome:
    """视图发布：冻结包 → 发布前完整成员校验 → 交换库 PREPARING → 文件可达检查
    → 单事务PUBLISHED + PublicationItem落库。

    R05/R42：任一必需成员（Asset/Blob/Location/文件存在/Blob健康）不满足即阻断，
    不再静默 continue；交换区保持不可见。
    """
    if ctx.dry_run:
        return StepOutcome("SUCCEEDED", outputs={"dry_run": True})
    pr = _package_revision(ctx)
    if pr is None:
        return StepOutcome("FAILED", error={"message": "no frozen package revision"})
"""连接器SDK（02 §6、10 §1—§2）。

插件不持有任意SQL执行权限；对象名走允许列表；查询值全部参数绑定。
"""
from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Protocol


@dataclass
class SourceScope:
    """已批准的读取作用域（10 §2.1）：锁定来源系统、库、schema、命名空间版本。"""
    tenant_id: str
    source_system_code: str
    database: str | None = None
    schema: str | None = None
    namespace: str = ""
    namespace_version: str = "1"

    def object_ref(self, obj: str) -> str:
        parts = [self.database, self.schema, obj]
        return ".".join(p for p in parts if p)


@dataclass
class SlideCandidate:
    source_object: str
    source_key: str          # Pitaya_Slice.Id 原值字符串
    barcode_raw: str         # qptmh 原值
    pathology_no: str        # PathologyID 原值
    block_key: str | None    # lkh 原值
    status_raw: dict = field(default_factory=dict)  # qpzt/zpzt/tmdyzt 原值，不解释
    observed_at: str = ""
    raw_digest: str = ""
    evidence_level: str = "SOURCE_RECORD"


@dataclass
class CaseRecord:
    source_object: str
    source_key: str
    pathology_no: str
    patient_source_id: str | None
    in_patient_id: str | None
