# 生产参考形态（PostgreSQL；W14补齐：Dockerfile/migrate服务/共享卷/无内嵌worker）。
# 本机无docker：**未执行容器构建与清洁环境安装演练**（阶段E现场项）。
services:
  db:
    image: postgres:16
    environment:
      POSTGRES_DB: blyb
      POSTGRES_USER: blyb
      POSTGRES_PASSWORD: "${BLYB_DB_PASSWORD:?set BLYB_DB_PASSWORD}"
    volumes: ["pgdata:/var/lib/postgresql/data"]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U blyb"]
      interval: 5s
      retries: 10
  migrate:
    build: ../..
    command: python -m apps.migrate
    environment: &env
      BLYB_DATABASE_URL: postgresql+psycopg://blyb:${BLYB_DB_PASSWORD}@db:5432/blyb
      BLYB_STORAGE_EMBEDDED_WORKER: "0"
    depends_on:
      db: { condition: service_healthy }
    restart: "no"
  core:
    build: ../..
    command: python -m uvicorn apps.core_api.app:get_app --host 0.0.0.0 --port 8000
    environment: *env
    depends_on:
      db: { condition: service_healthy }
      migrate: { condition: service_completed_successfully }
    ports: ["8000:8000"]
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request;urllib.request.urlopen('http://127.0.0.1:8000/health')\""]
      interval: 10s
      retries: 12
  storage:
    build: ../..
    command: python -m uvicorn apps.storage_service.app:get_app --host 0.0.0.0 --port 8001
    environment: *env
    depends_on:
      db: { condition: service_healthy }
      migrate: { condition: service_completed_successfully }
    ports: ["8001:8001"]
    volumes: ["volume1:/data/volume1"]
  exchange:
    build: ../..
    command: python -m uvicorn apps.exchange_gateway.app:get_app --host 0.0.0.0 --port 8002
    environment:
      <<: *env
      BLYB_EXCHANGE_DB: /data/exchange/exchange.sqlite3
    depends_on:
      db: { condition: service_healthy }
      migrate: { condition: service_completed_successfully }
    ports: ["8002:8002"]
    volumes: ["exchange:/data/exchange", "volume1:/data/volume1:ro"]
  worker:
    build: ../..
    command: python -m apps.worker.engine
    environment:
      <<: *env
      BLYB_EXCHANGE_DB: /data/exchange/exchange.sqlite3
    depends_on:
      db: { condition: service_healthy }
      migrate: { condition: service_completed_successfully }
    volumes:
      - "volume1:/data/volume1"      # 发布可达性检查/对象读取
      - "exchange:/data/exchange"    # 交换库写入
volumes:
  pgdata:
  volume1:
  exchange:

