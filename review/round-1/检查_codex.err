 succeeded in 2910ms:
"""Warehouse 实现：合成仓储 + SQL Server/Oracle 真驱动入口。

- SyntheticWarehouse：不执行SQL，按 template_id 语义过滤合成行；测试可变更行并
  以事件序列号驱动 poll_changes（F02 唤醒、F14 内容修订）。
- SqlServerWarehouse / OracleWarehouse：模板→方言SQL、参数绑定、行数上限；
  驱动未安装时抛 DRIVER_UNAVAILABLE，不假成功。
"""
from __future__ import annotations

import threading

from connector_sdk import CapabilityError, driver_unavailable

# ---------------------------------------------------------------- 模板注册表
# SQL 仅在真实驱动路径使用；对象名来自批准允许列表，值全部参数绑定。
TEMPLATES: dict[str, dict] = {
    "pis.slide_by_barcode": {
        "sqlserver": "SELECT TOP ({limit}) Id, qptmh, PathologyID, lkh, qpzt, zpzt, tmdyzt "
                     "FROM [{database}].[{schema}].[Pitaya_Slice] WHERE qptmh = ? ORDER BY Id",
        "params": ["barcode"],
    },
    "pis.case_by_pathology": {
        "sqlserver": "SELECT TOP ({limit}) * FROM [{database}].[{schema}].[Pitaya] "
                     "WHERE PathologyID = ?",
        "params": ["pathology_no"],
    },
    "pis.slides_by_case": {
        "sqlserver": "SELECT TOP ({limit}) Id, qptmh, PathologyID, lkh, qpzt, zpzt, tmdyzt "
                     "FROM [{database}].[{schema}].[Pitaya_Slice] "
                     "WHERE PathologyID = ? AND Id > ? ORDER BY Id",
        "params": ["pathology_no", "after_id"],
        "note": "keyset分页（R31）：Id游标逐页取，短页即末页",
    },
    "pis.applications_by_reqnote": {
        "sqlserver": "SELECT TOP ({limit}) * FROM [{database}].[{schema}].[患者检查申请信息表] "
                     "WHERE 申请号 = ?",
        "params": ["req_note_id"],
    },
    "pis.reports_by_case": {
        "sqlserver": "SELECT TOP ({limit}) * FROM [{database}].[{schema}].[患者检查报告信息表] "
                     "WHERE 报告流水号 = ? OR 报告流水号 LIKE ? ORDER BY 报告流水号",
        "params": ["pathology_no", "pathology_like"],
    },
    "pis.poll_cases_created": {
        "sqlserver": "SELECT TOP ({limit}) PathologyID, CreateTime FROM "
                     "[{database}].[{schema}].[Pitaya] "
                     "WHERE (CreateTime > ? OR (CreateTime = ? AND PathologyID > ?)) "
                     "AND CreateTime <= ? ORDER BY CreateTime, PathologyID",
        "params": ["since", "since", "after_key", "until"],
        "note": "INSERT_DISCOVERY_ONLY + (CreateTime,PathologyID)复合游标（R11："
                "同刻多行不丢；包含/排除边界明确：since为开区间下界、until为闭区间上界）",
    },
    "pis.scan_partition_cases": {
        "sqlserver": "SELECT TOP ({limit}) * FROM [{database}].[{schema}].[Pitaya] "
                     "WHERE PathologyID >= ? AND PathologyID < ? AND PathologyID > ? "
                     "ORDER BY PathologyID",
        "params": ["key_from", "key_to", "after_key"],
        "note": "keyset分页（R10）：after_key为已读末键，翻页到短页才算末页",
    },
    "pis.images_by_exam": {
        "sqlserver": "SELECT TOP ({limit}) * FROM [{database}].[{schema}].[V_PIS_IMAGE] "
                     "WHERE EXAMID = ?",
        "params": ["pathology_no"],
    },
    "his.patient_by_id": {
        "oracle": "SELECT * FROM (SELECT PATIENT_ID, ID_TYPE, ID_NO, NAME, SEX, DATE_OF_BIRTH "
                  "FROM {schema}.PAT_MASTER_INDEX WHERE PATIENT_ID = :patient_id) "
                  "WHERE ROWNUM <= {limit}",
        "params": ["patient_id"],
    },
    "his.encounters_by_patient": {
        "oracle": "SELECT * FROM (SELECT PATIENT_ID, VISIT_ID, INSURANCE_TYPE "
                  "FROM {schema}.PAT_VISIT WHERE PATIENT_ID = :patient_id) "
                  "WHERE ROWNUM <= {limit}",
        "params": ["patient_id"],
    },
}


def render_sql(template_id: str, dialect: str, *, limit: int,
               database: str = "", schema: str = "") -> str:
    t = TEMPLATES[template_id]
    if dialect not in t:
        raise CapabilityError("CAPABILITY_UNSUPPORTED",
                              f"template {template_id} has no {dialect} variant")
    return t[dialect].format(limit=limit, database=database, schema=schema)


_READONLY_PREFIX = "SELECT"


def _assert_readonly(sql: str) -> None:
    """W09只读防护：模板渲染后的SQL必须以SELECT开头（空白忽略）。

    允许列表内的对象名经 render_sql 拼接，值全部参数绑定；任何非SELECT
    语句（含被篡改模板产生的 UPDATE/DELETE/DROP）在执行前阻断。
    """
    head = sql.lstrip().upper()
    if not head.startswith(_READONLY_PREFIX):
        raise CapabilityError("CAPABILITY_UNSUPPORTED",
                              f"read-only warehouse rejected non-SELECT statement: "
                              f"{head.split()[0] if head.split() else '<empty>'}")


def _translate_dbapi_error(exc: Exception) -> Exception:
    """DBAPI驱动异常 → 明确能力错误（连接失败/超时不得伪装成空结果）。"""
    msg = str(exc).lower()
    if "timeout" in msg or "timed out" in msg or "cancel" in msg:
        return CapabilityError("SOURCE_QUERY_TIMEOUT", f"source query timed out: {exc}")
    return CapabilityError("SOURCE_CONNECT_FAILED", f"source connection failed: {exc}")


class SyntheticWarehouse:
    """按 template_id 语义查询合成行。线程安全；支持测试中动态改行。"""

    dialect_name = "synthetic"

    def __init__(self, *, namespace: str = "PITAYA", his_namespace: str = "MEDREC"):
        from . import fixtures
        self._lock = threading.RLock()
        self.namespace = namespace
        self.his_namespace = his_namespace
        self.rows = {
            "Pitaya_Slice": [dict(r) for r in fixtures.SLIDES],
            "Pitaya": [dict(r) for r in fixtures.CASES],
            "患者检查申请信息表": [dict(r) for r in fixtures.APPLICATIONS],
            "患者检查报告信息表": [dict(r) for r in fixtures.REPORTS],
            "PAT_MASTER_INDEX": [dict(r) for r in fixtures.PATIENTS],
            "PAT_VISIT": [dict(r) for r in fixtures.ENCOUNTERS],
            "V_PIS_IMAGE": [dict(r) for r in fixtures.V_PIS_IMAGE],
        }

    # -- 测试辅助 ------------------------------------------------------------
    def upsert_row(self, table: str, row: dict) -> None:
        with self._lock:
            self.rows[table].append(dict(row))

    def mutate_row(self, table: str, match: dict, changes: dict) -> int:
        n = 0
        with self._lock:
            for r in self.rows[table]:
                if all(r.get(k) == v for k, v in match.items()):
                    r.update(changes)
                    n += 1
        return n

    def mark_void(self, table: str, match: dict) -> int:
        return self.mutate_row(table, match, {"作废标记": 1})

    # -- Warehouse 协议 -------------------------------------------------------
    def dialect(self) -> str:
        return self.dialect_name

    def _ns_rows(self, table: str):
        if table in ("Pitaya_Slice", "Pitaya", "患者检查申请信息表", "患者检查报告信息表"):
            return [r for r in self.rows[table]
                    if r.get("__namespace", "PITAYA") == self.namespace]
        return self.rows[table]

    def fetch_all(self, template_id: str, params: dict, limit: int, *,
                  database: str = "", schema: str = "") -> list[dict]:
        # R21：Warehouse 协议统一接收对象作用域（合成仓储按 namespace 隔离，忽略该参数）
        with self._lock:
            if template_id == "pis.slide_by_barcode":
                rows = [r for r in self._ns_rows("Pitaya_Slice")
                        if r["qptmh"] == params["barcode"]]
                rows.sort(key=lambda r: r["Id"])
                return rows[:limit]
            if template_id == "pis.case_by_pathology":
                return [r for r in self._ns_rows("Pitaya")
                        if r["PathologyID"] == params["pathology_no"]][:limit]
            if template_id == "pis.slides_by_case":
                rows = [r for r in self._ns_rows("Pitaya_Slice")
                        if r["PathologyID"] == params["pathology_no"]
                        and r["Id"] > params.get("after_id", 0)]
                rows.sort(key=lambda r: r["Id"])
                return rows[:limit]
            if template_id == "pis.applications_by_reqnote":
                return [r for r in self._ns_rows("患者检查申请信息表")
                        if r["申请号"] == params["req_note_id"]][:limit]
            if template_id == "pis.reports_by_case":
                rows = [r for r in self._ns_rows("患者检查报告信息表")
                        if r["报告流水号"] == params.get("pathology_no")
                        or r["报告流水号"].startswith(params.get("pathology_no", "") + "-")]
                return rows[:limit]
            if template_id == "pis.poll_cases_created":
                after_key = params.get("after_key", "")
                rows = [r for r in self._ns_rows("Pitaya")
                        if (r["CreateTime"] > params["since"]
                            or (r["CreateTime"] == params["since"]
                                and str(r["PathologyID"]) > after_key))
                        and r["CreateTime"] <= params["until"]]
                rows.sort(key=lambda r: (r["CreateTime"], r["PathologyID"]))
                return rows[:limit]
            if template_id == "pis.scan_partition_cases":
                after_key = params.get("after_key", "")
                rows = [r for r in self._ns_rows("Pitaya")
                        if params["key_from"] <= r["PathologyID"] < params["key_to"]
                        and str(r["PathologyID"]) > after_key]
                rows.sort(key=lambda r: r["PathologyID"])
                return rows[:limit]
            if template_id == "pis.images_by_exam":
                return [r for r in self._ns_rows("V_PIS_IMAGE")
                        if r["EXAMID"] == params["pathology_no"]][:limit]
            if template_id == "his.patient_by_id":
                return [r for r in self.rows["PAT_MASTER_INDEX"]
                        if r["PATIENT_ID"] == params["patient_id"]][:limit]
            if template_id == "his.encounters_by_patient":
                rows = [r for r in self.rows["PAT_VISIT"]
                        if r["PATIENT_ID"] == params["patient_id"]]
                rows.sort(key=lambda r: r["VISIT_ID"])
                return rows[:limit]
        raise CapabilityError("CAPABILITY_UNSUPPORTED", f"unknown template {template_id}")


class SqlServerWarehouse:
    """SQL Server 真驱动访问。未安装 pyodbc/未配置 DSN 时显式失败。

    W09：只读防护（非SELECT阻断）、参数绑定、cursor显式关闭、
    连接级查询超时（conn.timeout）与取消（conn.cancel）、
    连接失败/超时翻译为能力错误（不伪装空结果）。
    """

    dialect_name = "sqlserver"

    def __init__(self, connection_factory=None, *, timeout_seconds: float = 30.0):
        self._conn_factory = connection_factory  # 注入用于隔离测试；生产由驱动创建
        self._driver = None
        self._timeout = timeout_seconds
        if connection_factory is None:
            try:
                import pyodbc  # noqa: F401
                self._driver = pyodbc
            except ImportError as exc:
                raise driver_unavailable("pyodbc", str(exc)) from exc

    def dialect(self) -> str:
        return self.dialect_name

    def fetch_all(self, template_id: str, params: dict, limit: int,
                  *, database: str = "", schema: str = "") -> list[dict]:
        sql = render_sql(template_id, "sqlserver", limit=limit,
                         database=database, schema=schema)
        _assert_readonly(sql)
        order = TEMPLATES[template_id]["params"]
        args = [params[k] for k in order]
        conn = None
        try:
            conn = self._conn_factory() if self._conn_factory else self._driver.connect(
                _sqlserver_dsn_from_env())
            try:
                conn.timeout = self._timeout  # pyodbc 连接级查询超时
            except Exception:  # noqa: BLE001 —— fake驱动可不支持该属性
                pass
            cur = conn.cursor()
            try:
                cur.execute(sql, args)  # qmark参数绑定，值不进SQL文本
                cols = [d[0] for d in cur.description]
                return [dict(zip(cols, row)) for row in cur.fetchall()]
            finally:
                cur.close()
        except CapabilityError:
            raise
        except Exception as exc:  # noqa: BLE001
            cancel = getattr(conn, "cancel", None)
            if callable(cancel):
                try:
                    cancel()
                except Exception:  # noqa: BLE001
                    pass
            raise _translate_dbapi_error(exc) from exc
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:  # noqa: BLE001
                    pass


class OracleWarehouse:
    """Oracle 真驱动访问（R22）。构造条件：注入连接工厂，或
    （驱动可导入 且 BLYB_ORACLE_DSN 已配置）；缺驱动/缺DSN显式 DRIVER_UNAVAILABLE，
    不伪成功也不误报。连接延迟到 fetch_all。

    W09：只读防护、named绑定、cursor关闭、call_timeout毫秒级超时、
    连接失败/超时翻译为能力错误。
    """

    dialect_name = "oracle"

    def __init__(self, connection_factory=None, *, timeout_seconds: float = 30.0):
        self._conn_factory = connection_factory
        self._dsn = None
        self._timeout_ms = int(timeout_seconds * 1000)
        if connection_factory is not None:
            return
        import os
        try:
            import oracledb  # noqa: F401
        except ImportError as exc:
            raise driver_unavailable("oracledb", str(exc)) from exc
        self._dsn = os.environ.get("BLYB_ORACLE_DSN", "")
        if not self._dsn:
            raise driver_unavailable(
                "oracledb", "driver installed but BLYB_ORACLE_DSN not configured; "
                            "set it for integration test")

    def dialect(self) -> str:
        return self.dialect_name

    def fetch_all(self, template_id: str, params: dict, limit: int,
                  *, database: str = "", schema: str = "") -> list[dict]:
        sql = render_sql(template_id, "oracle", limit=limit, database=database, schema=schema)
        _assert_readonly(sql)
        conn = None
        try:
            conn = self._conn_factory() if self._conn_factory else __import__(
                "oracledb").connect(self._dsn)
            try:
                conn.call_timeout = self._timeout_ms  # oracledb 毫秒级调用超时
            except Exception:  # noqa: BLE001 —— fake驱动可不支持该属性
                pass
            cur = conn.cursor()
            try:
                cur.execute(sql, {k: params[k] for k in TEMPLATES[template_id]["params"]})
                cols = [d[0] for d in cur.description]
                return [dict(zip(cols, row)) for row in cur.fetchall()]
            finally:
                cur.close()
        except CapabilityError:
            raise
        except Exception as exc:  # noqa: BLE001
            raise _translate_dbapi_error(exc) from exc
        finally:
            if conn is not None:
                try:
                    conn.close()
                except Exception:  # noqa: BLE001
                    pass


def _sqlserver_dsn_from_env() -> str:
    import os
    dsn = os.environ.get("BLYB_PIS_SQLSERVER_DSN")
    if not dsn:
        raise driver_unavailable("pyodbc", "BLYB_PIS_SQLSERVER_DSN not configured")
    return dsn

"""交换发布库（独立数据库；对外视图只读已发布行）。

实现 05 §6：release_batch / projection_row / asset_route / tombstone /
publication_evidence。核心库与交换库之间不用假想原子事务，靠 generation 查证恢复。

R03/R05/R06/R07 整改后的版本模型：
- scope 身份 = (tenant_id, dataset_scope)。scope 唯一性不再依赖 destination.code 单值。
- 可见集 = dataset_current 业务键当前指针（增量模型）：发布某批次只替换该批次
  覆盖的业务键，不清除同 scope 其他病例的指针；更正病例 = 同键新指针。
- release_batch 保留 generation 记录；旧批次 SUPERSEDED 后其 asset_route 在
  保留窗口内仍可读（URL 稳定、字节固定），REVOKED/损坏才停止提供。
- route_id 由 uuid5(batch_id, asset_id) 派生，跨进程/重启稳定（R07）。
"""
from __future__ import annotations

import json
import os
import sqlite3
import threading
import uuid
from datetime import datetime, timezone

SCHEMA = """
CREATE TABLE IF NOT EXISTS release_batch (
  batch_id TEXT PRIMARY KEY,
  publication_id TEXT NOT NULL,
  generation_id TEXT NOT NULL,
  tenant_id TEXT NOT NULL DEFAULT '',
  dataset_scope TEXT NOT NULL DEFAULT '',
  state TEXT NOT NULL,             -- PREPARING / PUBLISHED / SUPERSEDED / REVOKED
  row_count INTEGER NOT NULL DEFAULT 0,
  manifest_digest TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL,
  published_at TEXT,
  superseded_at TEXT
);
CREATE TABLE IF NOT EXISTS projection_row (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  batch_id TEXT NOT NULL REFERENCES release_batch(batch_id),
  dataset TEXT NOT NULL,           -- 视图名：chk_info / rpt_info / asset_info / metrics ...
  external_key TEXT NOT NULL,
  payload TEXT NOT NULL,           -- JSON
  UNIQUE (batch_id, dataset, external_key)
);
CREATE TABLE IF NOT EXISTS dataset_current (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  tenant_id TEXT NOT NULL DEFAULT '',
  dataset_scope TEXT NOT NULL,
  dataset TEXT NOT NULL,
  external_key TEXT NOT NULL,
  batch_id TEXT NOT NULL,
  payload TEXT NOT NULL,
  updated_at TEXT NOT NULL,
  UNIQUE (tenant_id, dataset_scope, dataset, external_key)
);
CREATE TABLE IF NOT EXISTS asset_route (
  route_id TEXT PRIMARY KEY,
  batch_id TEXT NOT NULL REFERENCES release_batch(batch_id),
  asset_id TEXT NOT NULL,
  physical_key TEXT NOT NULL,
  size_bytes INTEGER NOT NULL,
  sha256 TEXT NOT NULL,
  media_type TEXT NOT NULL DEFAULT 'application/octet-stream',
  state TEXT NOT NULL DEFAULT 'PENDING'   -- PENDING / REACHABLE
);
CREATE UNIQUE INDEX IF NOT EXISTS uq_route_batch_asset ON asset_route(batch_id, asset_id);
CREATE TABLE IF NOT EXISTS tombstone (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  batch_id TEXT NOT NULL,
  dataset TEXT NOT NULL,
  external_key TEXT NOT NULL,
  reason TEXT NOT NULL DEFAULT '',
  created_at TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS publication_evidence (
  id INTEGER PRIMARY KEY AUTOINCREMENT,
  publication_id TEXT NOT NULL,
  kind TEXT NOT NULL,              -- visible / downloaded / receipt
  detail TEXT NOT NULL DEFAULT '',
  at TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS ix_proj_dataset ON projection_row(dataset, external_key);
"""


def _upgrade(conn: sqlite3.Connection) -> None:
    """旧交换库升级（编号迁移的等价实现，连接时幂等执行）。

    - exchange.002：补 tenant_id 列。
    - exchange.003：tombstone 唯一索引 (batch_id, dataset, external_key)
      （LG-05：并发/重复撤回不双写墓碑）。存量库若已有重复墓碑导致索引
      建不起来，记录告警并跳过——只读盘点交人工确认，不默删历史。
    """
    import logging
    log = logging.getLogger(__name__)
    cols = {r[1] for r in conn.execute("PRAGMA table_info(release_batch)").fetchall()}
    if cols and "tenant_id" not in cols:
        conn.execute(
            "ALTER TABLE release_batch ADD COLUMN tenant_id TEXT NOT NULL DEFAULT ''")
        conn.commit()
    idx = [r[0] for r in conn.execute(
        "SELECT name FROM sqlite_master WHERE type='index'"
        " AND name='ux_tombstone_key'").fetchall()]
    if not idx:
        try:
            conn.execute(
                "CREATE UNIQUE INDEX IF NOT EXISTS ux_tombstone_key"
                " ON tombstone(batch_id, dataset, external_key)")
            conn.commit()
        except sqlite3.IntegrityError:
            log.warning(
                "exchange.003 skipped: legacy duplicate tombstones exist; "
                "manual review required before the unique index can be created")


class ExchangeDb:
    def __init__(self, path: str):
        self.path = path
        os.makedirs(os.path.dirname(os.path.abspath(path)) or ".", exist_ok=True)
        self.conn = sqlite3.connect(path, check_same_thread=False)
        self.conn.row_factory = sqlite3.Row
        self.conn.execute("PRAGMA journal_mode=WAL")
        self.conn.executescript(SCHEMA)
        self.conn.commit()
        _upgrade(self.conn)
        self._lock = threading.RLock()

    # ------------------------------------------------ 写侧（发布器）
    def begin_batch(self, publication_id: str, generation_id: str, dataset_scope: str,
                    manifest_digest: str, tenant_id: str = "") -> str:
        batch_id = f"batch-{generation_id}"
        with self._lock:
            self.conn.execute(
                "INSERT OR IGNORE INTO release_batch (batch_id, publication_id, generation_id,"
                " tenant_id, dataset_scope, state, manifest_digest, created_at)"
                " VALUES (?,?,?,?,?,?,?,?)",
                (batch_id, publication_id, generation_id, tenant_id, dataset_scope,
                 "PREPARING", manifest_digest, _now()))
            self.conn.commit()
        return batch_id

    def upsert_projection(self, batch_id: str, dataset: str, external_key: str, payload: dict):
        with self._lock:
            self.conn.execute(
                "INSERT INTO projection_row (batch_id, dataset, external_key, payload)"
                " VALUES (?,?,?,?) ON CONFLICT(batch_id, dataset, external_key)"
                " DO UPDATE SET payload=excluded.payload",
                (batch_id, dataset, external_key, json.dumps(payload, ensure_ascii=False)))
            self.conn.commit()

    def add_asset_route(self, batch_id: str, asset_id: str, physical_key: str,
                        size_bytes: int, sha256: str, media_type: str) -> str:
        # uuid5 确定性派生：同 (batch, asset) 跨进程/重启同值（R07），不再用 hash()
        route_id = str(uuid.uuid5(uuid.NAMESPACE_URL, f"blyb:route:{batch_id}:{asset_id}"))
        with self._lock:
            self.conn.execute(
                "INSERT OR IGNORE INTO asset_route (route_id, batch_id, asset_id,"
                " physical_key, size_bytes, sha256, media_type, state)"
                " VALUES (?,?,?,?,?,?,?,?)",
                (route_id, batch_id, asset_id, physical_key, size_bytes, sha256,
                 media_type, "PENDING"))
            self.conn.commit()
        return route_id

    def mark_asset_reachable(self, route_id: str):
        with self._lock:
            self.conn.execute("UPDATE asset_route SET state='REACHABLE' WHERE route_id=?",
                              (route_id,))
            self.conn.commit()

    def revoke_route(self, route_id: str):
        """安全隔离：单路由停止提供（保留记录）。"""
        with self._lock:
            self.conn.execute("UPDATE asset_route SET state='REVOKED' WHERE route_id=?",
                              (route_id,))
            self.conn.commit()

    def add_tombstone(self, batch_id: str, dataset: str, external_key: str, reason: str):
        """墓碑写入幂等（LG-05：exchange.003 唯一索引兜底并发双写）。"""
        with self._lock:
            self.conn.execute(
                "INSERT OR IGNORE INTO tombstone"
                " (batch_id, dataset, external_key, reason, created_at)"
                " VALUES (?,?,?,?,?)", (batch_id, dataset, external_key, reason, _now()))
            self.conn.commit()

    def revoke_batch(self, batch_id: str) -> dict:
        """撤回的结构化可见性处理（LG-13，单事务）：

        - release_batch 置 REVOKED（文件路由读侧 asset_route_by_id 因
          batch_state 不在 (PUBLISHED, SUPERSEDED) 而整体停供）；
        - 删除 dataset_current 中仍指向本批次的当前指针：这些业务键从
          结构化当前视图消失；同 scope 其他批次拥有的键不受影响
          （增量模型：dataset_current 指针归属哪个批次就随哪个批次撤回）。
        历史payload（projection_row/release_batch/路由记录）全部保留。
        """
        with self._lock:
            cur = self.conn
            n = cur.execute(
                "UPDATE release_batch SET state='REVOKED'"
                " WHERE batch_id=? AND state<>'REVOKED'", (batch_id,)).rowcount
            removed = cur.execute(
                "DELETE FROM dataset_current WHERE batch_id=?", (batch_id,)).rowcount
            cur.commit()
            return {"batch_state_updated": n, "current_pointers_removed": removed}

    def publish_batch(self, batch_id: str) -> int:
        """单事务：置PUBLISHED、旧代际转SUPERSEDED（仅账面，不清可见集）、
        刷新 dataset_current 当前指针（只覆盖本批次含有的业务键）。"""
        with self._lock:
            cur = self.conn
            row = cur.execute("SELECT generation_id, dataset_scope, tenant_id"
                              " FROM release_batch WHERE batch_id=?", (batch_id,)).fetchone()
            if row is None:
                raise ValueError("batch not found")
            count = cur.execute("SELECT COUNT(*) c FROM projection_row WHERE batch_id=?",
                                (batch_id,)).fetchone()["c"]
            cur.execute(
                "UPDATE release_batch SET state='SUPERSEDED', superseded_at=?"
                " WHERE tenant_id=? AND dataset_scope=? AND state='PUBLISHED' AND batch_id<>?",
                (_now(), row["tenant_id"], row["dataset_scope"], batch_id))
            for pr in cur.execute(
                    "SELECT dataset, external_key, payload FROM projection_row"
                    " WHERE batch_id=?", (batch_id,)).fetchall():
                cur.execute(
                    "INSERT INTO dataset_current (tenant_id, dataset_scope, dataset,"
                    " external_key, batch_id, payload, updated_at)"
                    " VALUES (?,?,?,?,?,?,?)"
                    " ON CONFLICT(tenant_id, dataset_scope, dataset, external_key)"
                    " DO UPDATE SET batch_id=excluded.batch_id, payload=excluded.payload,"
                    " updated_at=excluded.updated_at",
                    (row["tenant_id"], row["dataset_scope"], pr["dataset"],
                     pr["external_key"], batch_id, pr["payload"], _now()))
            n = cur.execute("UPDATE release_batch SET state='PUBLISHED', published_at=?,"
                            " row_count=? WHERE batch_id=? AND state='PREPARING'",
                            (_now(), count, batch_id)).rowcount
            cur.commit()
            return n

    def add_evidence(self, publication_id: str, kind: str, detail: dict):
        with self._lock:
            self.conn.execute(
                "INSERT INTO publication_evidence (publication_id, kind, detail, at)"
                " VALUES (?,?,?,?)",
                (publication_id, kind, json.dumps(detail, ensure_ascii=False), _now()))
            self.conn.commit()

    # ------------------------------------------------ 读侧（采集器）
    def current_generation(self, dataset_scope: str, tenant_id: str = "") -> dict | None:
        with self._lock:
            row = self.conn.execute(
                "SELECT * FROM release_batch WHERE tenant_id=? AND dataset_scope=?"
                " AND state='PUBLISHED'"
                " ORDER BY published_at DESC LIMIT 1", (tenant_id, dataset_scope)).fetchone()
        return dict(row) if row else None

    def view_rows(self, dataset: str, dataset_scope: str, limit: int = 200,
                  cursor: int = 0, tenant_id: str = "") -> tuple[list[dict], int]:
        """读业务键当前指针集合（增量可见集），不再随最新generation整体切换。"""
        with self._lock:
            rows = self.conn.execute(
                "SELECT id, external_key, payload, batch_id FROM dataset_current"
                " WHERE tenant_id=? AND dataset_scope=? AND dataset=? AND id>?"
                " ORDER BY id LIMIT ?",
                (tenant_id, dataset_scope, dataset, cursor, limit)).fetchall()
        out = [{"external_key": r["external_key"], "payload": json.loads(r["payload"]),
                "cursor": r["id"], "batch_id": r["batch_id"]} for r in rows]
        return out, (rows[-1]["id"] if rows else 0)

    def asset_route_by_id(self, route_id: str) -> dict | None:
        """SUPERSEDED 批次路由在保留窗口内仍可读（R06）；REVOKED 不提供。"""
        with self._lock:
            row = self.conn.execute(
                "SELECT ar.*, rb.state AS batch_state FROM asset_route ar"
                " JOIN release_batch rb ON rb.batch_id=ar.batch_id"
                " WHERE ar.route_id=?", (route_id,)).fetchone()
        if row is None or row["batch_state"] not in ("PUBLISHED", "SUPERSEDED"):
            return None
        if row["state"] not in ("REACHABLE",):
            return None
        return dict(row)

    def close(self):
        self.conn.close()


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()

