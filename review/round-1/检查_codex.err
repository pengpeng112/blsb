# 请求体模型必须定义在模块级：本文件有 `from __future__ import annotations`，
# 端点注解是字符串；定义在 create_app 内的局部类无法被 FastAPI 解析为
# Body 参数，会被静默降级为 query 参数（曾导致这批 POST 端点全数 422）。
class ConnectorBody(BaseModel):
