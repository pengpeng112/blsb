    @app.get("/api/v1/packages/{package_id}/revisions/{revision}")
    def get_package_revision(package_id: str, revision: int, ctx=Depends(auth)):
        """T3 固定包读取：冻结内容只读（跨租户/不存在404）；附件仅引用不内联
        二进制；payload.index.serialized 以掩码形态返回（T10读取路径防护，
        digest 仍为冻结原文摘要可供比对）。"""
        p = ctx.require_principal()
        with sf() as db:
            pkg = db.get(DataPackage, package_id)
            if pkg is None or pkg.tenant_id != p.tenant_id:
                raise ApiError("NOT_FOUND", "package not found")
            pr = (db.query(PackageRevision)
                  .filter_by(package_id=pkg.id, revision=revision).first())
            if pr is None:
                raise ApiError("NOT_FOUND", "package revision not found")
            payload = dict(pr.payload or {})
            idx = payload.get("index")
            if isinstance(idx, dict) and isinstance(idx.get("serialized"), str):
                idx = dict(idx)
                idx["serialized"] = _mask_index_serialized(idx["serialized"])
                payload["index"] = idx
            attachments = []
            for s in (pr.payload or {}).get("slides", []) or []:
                for scan in s.get("scans", []):
                    if not scan.get("effective"):
                        continue
                    for a in scan.get("assets", []):
                        attachments.append({"asset_id": a.get("asset_id"),
                                            "sha256": a.get("sha256"),
                                            "size_bytes": a.get("size_bytes"),
                                            "role": a.get("role")})
            return ok({
                "package_id": pkg.id, "domain": pkg.domain,
                "business_key": pkg.business_key,
                "revision": pr.revision, "state": pr.state,
                "digest": pr.digest, "schema_ref": pr.schema_ref,
                "provenance": pr.provenance, "payload": payload,
                "attachments": attachments,
                "created_at": pr.created_at.isoformat(),
                "note": "payload.index.serialized 已按读取路径防护掩码；"
                        "digest 为冻结原文摘要",
            }, ctx.request_id)

    @app.post("/api/v1/publications/{publication_id}/revoke")
    def revoke_publication(publication_id: str, body: dict, ctx=Depends(auth)):
        """T4 撤回：仅本租户且 PUBLISHED 可撤回；manifest 路由逐个 revoke，
        PublicationItem 逐个写墓碑；幂等重复撤回 200。"""
        p = ctx.require_principal()
        p.require_any_role(ROLE_OPERATOR, ROLE_PLATFORM_ADMIN)
        reason = str(((body or {}).get("reason")) or "").strip()
        if not reason:
            raise ApiError("VALIDATION_FAILED",
                           "reason required for publication revoke")
        with sf() as db:
            pub = db.get(Publication, publication_id)
            if pub is None or pub.tenant_id != p.tenant_id:
                raise ApiError("NOT_FOUND", "publication not found")
            if pub.state == "REVOKED":
                return ok({"publication_id": pub.id, "state": "REVOKED",
                           "idempotent": True}, ctx.request_id)
            if pub.state != "PUBLISHED":
                raise ApiError("CONFLICT",
                               f"publication state {pub.state} not revocable")
            manifest = pub.manifest_ref or {}
            routes = list(manifest.get("routes", []))
            batch_id = manifest.get("batch_id", "")
            items = db.query(PublicationItem).filter_by(
                publication_id=pub.id).all()
            from destinations.view_publication.exchange_db import ExchangeDb
            # 与 core_handlers/网关同源的默认交换库路径（apps/core_api 需3层dirname
            # 才到仓库根；层级错配会导致撤回写错库）
            exchange_path = os.environ.get(
                "BLYB_EXCHANGE_DB", os.path.join(
                    os.path.dirname(os.path.dirname(os.path.dirname(
                        os.path.abspath(__file__)))),
                    "var", "exchange.sqlite3"))
            ex = ExchangeDb(exchange_path)
            try:
                for route_id in routes:
                    ex.revoke_route(route_id)
                # 结构化当前视图一致性（LG-13）：批次置REVOKED并移除仍指向
                # 本批次的 dataset_current 指针——撤回后结构化读侧与文件
                # 路由同样不可见；其他批次拥有的键不受影响。
                if batch_id:
                    batch_view = ex.revoke_batch(batch_id)
                else:
                    batch_view = {"batch_state_updated": 0,
                                  "current_pointers_removed": 0}
                for item in items:
                    ex.add_tombstone(batch_id, item.entity_type,
                                     item.external_key, reason)
            finally:
                ex.close()
            pub.state = "REVOKED"
            pub.revoked_at = utcnow()
            audit(db, p, "publication.revoke", f"publication:{pub.id}",
                  old_ref={"state": "PUBLISHED", "generation": pub.generation_id},
    return (db.query(Operation)
            .filter_by(subject_ref=subject, op_type=op_type)
            .order_by(Operation.created_at.desc()).first())


def verify_session(db: Session, session: UploadSession) -> dict:
    """合并校验并提交 blob/asset（worker 执行；幂等，dedup=session_id）。

    W07崩溃矩阵：阶段推进均先持久化意图（CREATED→ASSEMBLED→RENAMED→
    DB_COMMITTED），每个提交边界带 _crash_point 注入名；进程被kill后
    recover_commit_intents 按意图阶段幂等恢复。
    """
    op = _find_operation(db, session.id, "storage.verify_session")
    if op is not None and op.state == OperationState.SUCCEEDED:
        return op.result
    if op is not None:
        op.state = OperationState.RUNNING
    db.commit()

    vol_row = db.get(StorageVolume, session.volume_id)
    vol = VolumeHandle(vol_row.id, vol_row.root_ref, vol_row.safety_margin_bytes)
    asset = db.get(Asset, session.asset_id)
    error: dict = {}
    try:
        chunks = (db.query(UploadChunk).filter_by(session_id=session.id)
                  .order_by(UploadChunk.chunk_index).all())
        # W07：重入复用未决意图（kill后重试不再堆叠新意图行）
        intent = (db.query(StorageCommitIntent)
                  .filter_by(session_id=session.id,
                             resolved_at=None)
                  .order_by(StorageCommitIntent.created_at.desc()).first())
        if intent is None:
            intent = StorageCommitIntent(
                id=new_uuid(), tenant_id=session.tenant_id,
                session_id=session.id, blob_id=None,
                target_key=vol.object_path(f"pending-{session.id}"),
                digest=session.expected_sha256, phase="CREATED")
            db.add(intent)
            db.flush()
        _crash_point("before_intent_commit")
        db.commit()  # R40：意图先于任何文件操作独立提交，崩溃后可查证恢复
        _crash_point("intent_committed")

        assembling = storage_backend.assemble_file(
            vol, session.id, [c.storage_key for c in chunks], asset.id,
            session.expected_sha256, session.expected_size)
        intent.phase = "ASSEMBLED"
        db.commit()
        _crash_point("assembled")

        blob = (db.query(Blob).filter_by(tenant_id=session.tenant_id,
                                         sha256=session.expected_sha256,
                                         size_bytes=session.expected_size).first())
        if blob is None:
            blob = Blob(id=new_uuid(), tenant_id=session.tenant_id,
                        size_bytes=session.expected_size, sha256=session.expected_sha256,
                        state=BlobState.VERIFYING)
            db.add(blob)
            db.flush()
        obj_path = vol.object_path(blob.id)
        if not os.path.exists(obj_path):
            storage_backend.commit_object(vol, assembling, blob.id)
        # R41：内容去重复用既有对象时，本会话的 assembling 临时文件必须清理
        if os.path.exists(assembling):
            os.remove(assembling)
        intent.blob_id = blob.id
        intent.target_key = obj_path
        intent.phase = "RENAMED"
        db.commit()
        _crash_point("renamed")

        result = _finalize_commit(db, session, asset, blob, intent, vol_row, vol, op)
        return result
    except Exception as exc:  # noqa: BLE001
        db.rollback()
        log.exception("verify_session failed for %s", session.id)
        error = {"code": "FILE_HASH_MISMATCH" if "mismatch" in str(exc) else "STORAGE_FAILURE",
                 "message": str(exc)}
        session = db.query(UploadSession).get(session.id)
        asset = db.get(Asset, session.asset_id) if session is not None else None
        if session is not None:
            session.state = UploadSessionState.FAILED
            # 失败也必须释放卷预留，否则配额泄漏（H-02；W07经账本CAS恰好一次）
            vol_row = db.get(StorageVolume, session.volume_id)
            release_reservation(db, session.id, "FAIL")
            if vol_row is not None:
                import shutil
                shutil.rmtree(VolumeHandle(
                    vol_row.id, vol_row.root_ref,
                    vol_row.safety_margin_bytes).session_dir(session.id),
                    ignore_errors=True)
        if asset is not None and asset.state != AssetState.AVAILABLE:
            asset.state = AssetState.QUARANTINED
        op = _find_operation(db, session.id if session else "", "storage.verify_session")
        if op is not None:
            op.state = OperationState.FAILED
            op.error = error
        db.commit()
        raise ApiError(error.get("code", "STORAGE_CAPACITY_LOW"), error.get("message", "verify failed"))


def _finalize_commit(db: Session, session: UploadSession, asset: Asset, blob: Blob,
                     intent: StorageCommitIntent, vol_row: StorageVolume,
                     vol: VolumeHandle, op: Operation | None) -> dict:
    """核心提交（W07抽取，verify_session 与崩溃恢复共用）：
                          {"pathology_no": c["key"], "kind": c["kind"]})
        db.commit()

    def _j_storage_verify_session(self, db, job: Job):
        from core_db.models import UploadSession
        from apps.storage_service import service as storage_service
        session = db.get(UploadSession, job.payload["session_id"])
        result = storage_service.verify_session(db, session)
        from core_db.models import Operation
        op = db.get(Operation, job.payload.get("operation_id"))
        if op is not None:
            op.state = "SUCCEEDED"
            op.result = result
        db.commit()

    def _j_storage_verify_asset(self, db, job: Job):
        from apps.storage_service.service import verify_asset_job
        verify_asset_job(db, job)

    # ------------------------------------------------------------ 工作流推进
    def _rearm_waiting(self, db, retry_wait_seconds: float | None):
        """WAITING_EXTERNAL 步骤到达重试时限后重新入队（不占线程睡眠）。"""
        import time
        from datetime import timedelta
        threshold = retry_wait_seconds
        now = time.time()
        steps = db.query(StepRun).filter_by(state="WAITING_EXTERNAL").all()
        for s in steps:
            age = now - s.updated_at.timestamp()
            if threshold is None:
                threshold = 1.0
            if age >= threshold:
                s.state = "READY"
                s.updated_at = utcnow()
        db.commit()

