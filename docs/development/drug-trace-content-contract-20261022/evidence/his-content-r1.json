    "normal_trace_sample": {
      "sql": "SELECT HEADER_SOURCE,HEADER_FLAG,REFUND_FLAG,IN_OUT_TYPE,IS_DELETED,SPLIT_FLAG,\n       COUNT(*) AS SAMPLE_RECORDS,\n       SUM(CASE WHEN LENGTH(T_TRACE_CODE)=20\n                 AND REGEXP_LIKE(T_TRACE_CODE,'^[0-9]+$') THEN 1 ELSE 0 END) AS CODES_20_DIGITS,\n       SUM(CASE WHEN PRESC_DETAILID IS NULL THEN 1 ELSE 0 END) AS MISSING_DETAIL_ID,\n       SUM(CASE WHEN TRACES_SUM>1 THEN 1 ELSE 0 END) AS TRACES_SUM_GT_1\nFROM (\n    SELECT M.PRESC_SOURCE AS HEADER_SOURCE,M.FLAG AS HEADER_FLAG,M.REFUND_FLAG,\n           T.IN_OUT_TYPE,T.IS_DELETED,T.SPLIT_FLAG,T.T_TRACE_CODE,T.PRESC_DETAILID,T.TRACES_SUM\n    FROM (\n        SELECT PRESC_DATE,PRESC_NO,DISPENSARY,PRESC_SOURCE,FLAG,REFUND_FLAG\n        FROM PHARMACY.DRUG_PRESC_MASTER\n        WHERE DISPENSING_DATETIME>=TO_DATE('2026-10-22','yyyy-mm-dd')\n          AND DISPENSING_DATETIME<TO_DATE('2026-10-23','yyyy-mm-dd')\n          AND ROWNUM<=20\n    ) M\n    JOIN DRUG_USER.MED_TRACE_RECORD T\n      ON T.TRACE_BILLNO=TO_CHAR(M.PRESC_NO)\n     AND T.PRESC_DATE=M.PRESC_DATE\n     AND T.STORE_CODE=M.DISPENSARY\n    WHERE ROWNUM<=100\n)\nGROUP BY HEADER_SOURCE,HEADER_FLAG,REFUND_FLAG,IN_OUT_TYPE,IS_DELETED,SPLIT_FLAG",
      "sha256": "151a9c0ac9a115a07e47bdbee8809bc87fd38bbb17bb13b8e1fef867f3192d59",
