    "normal_scope_sample": {
      "sql": "SELECT PRESC_SOURCE,FLAG,REFUND_FLAG,TRACE_STATUS,COUNT(*) AS SAMPLE_BILLS\nFROM (\n    SELECT M.PRESC_SOURCE,M.FLAG,M.REFUND_FLAG,M.TRACE_STATUS\n    FROM PHARMACY.DRUG_PRESC_MASTER M\n    WHERE M.DISPENSING_DATETIME>=TO_DATE('2026-10-22','yyyy-mm-dd')\n      AND M.DISPENSING_DATETIME<TO_DATE('2026-10-23','yyyy-mm-dd')\n      AND ROWNUM<=100\n)\nGROUP BY PRESC_SOURCE,FLAG,REFUND_FLAG,TRACE_STATUS",
      "sha256": "034236888b55a5d357d7378aa0bb3c3333597d1774c344ec4e646f36ae203436",
