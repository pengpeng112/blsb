[Unit]
Description=BLYB DMZ drug-trace HTTPS forwarder (fixed upstream eco.taobao.com)
Documentation=file:/opt/blyb-dmz/current/README.socket.md
# 443 由 blyb-dmz-forwarder.socket 托管；本服务接收 systemd 传入监听 FD。
Requires=blyb-dmz-forwarder.socket
After=network-online.target blyb-dmz-forwarder.socket
Wants=network-online.target
ConditionPathExists=/etc/blyb-dmz/forwarder.json

[Service]
Type=simple
User=blyb-dmz
Group=blyb-dmz
# @PYTHON@ 由安装脚本渲染为私有运行时绝对路径（Anolis7.9 无系统 python3；
# 不 setcap 系统 Python、不升级整机 systemd/openssl——FIN-01）
ExecStartPre=@PYTHON@ /opt/blyb-dmz/current/forwarder.py --config /etc/blyb-dmz/forwarder.json --check-config
ExecStart=@PYTHON@ /opt/blyb-dmz/current/forwarder.py --config /etc/blyb-dmz/forwarder.json --listen-mode systemd
Restart=on-failure
RestartSec=5
# systemd 219 兼容的最小权限集合：无 AmbientCapabilities（229+）、无
# ProtectSystem=strict（只支持布尔/full）、无 append 日志、无 *Paths（用
# 219 的 *Directories 命名）。443 能力由 socket activation 承担，进程不需要
# CAP_NET_BIND_SERVICE。
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadOnlyDirectories=/opt/blyb-dmz
# 日志进 journal（219 无 per-unit journald 限额；全局保留策略不动，无 logrotate 依赖）
StandardOutput=journal
StandardError=journal
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
