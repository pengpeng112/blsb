{
  "_comment": "DMZ 转发器 v2 配置模板。复制为 /etc/blyb-dmz/forwarder.json 并按院方交付填写；私钥/证书文件 600、目录 700。listen_host 必须与 socket 单元 ListenStream 地址一致（systemd 模式下 FD 地址不符会拒绝启动）。所有路径为 DMZ 本机绝对路径。",
  "listen_host": "<relay-net-host>",
  "listen_port": 443,
  "backup_listen_port": 0,
  "tls_cert": "/etc/blyb-dmz/certs/forwarder.crt",
  "tls_key": "/etc/blyb-dmz/certs/forwarder.key",
  "client_ca": "/etc/blyb-dmz/certs/clients-ca.crt",
  "upstream_ca": "/etc/pki/tls/certs/ca-bundle.crt",
  "allow_ips": ["<prod-host>"],
  "allowed_top_methods": [
    "alibaba.alihealth.drugtrace.top.yljg.uploadretail",
    "alibaba.alihealth.drugtrace.top.yljg.query.billstatus"
  ],
  "enable_inout_upload": false,
  "max_body_bytes": 2097152,
  "max_response_bytes": 8388608,
  "rate_per_minute": 60,
  "rate_burst": 10,
  "max_concurrency": 8,
  "max_pending_handshakes": 16,
  "tls_handshake_timeout": 10.0,
  "header_timeout": 15.0,
  "body_read_timeout": 30.0,
  "write_timeout": 30.0,
  "total_request_deadline": 120.0,
  "upstream_connect_timeout": 5.0,
  "upstream_read_timeout": 20.0,
  "upstream_total_deadline": 60.0
}
