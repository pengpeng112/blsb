{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "organization_code": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "metric_code": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "amount": {
      "type": "string",
      "minLength": 1,
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    }
  },
  "required": [
    "organization_code",
    "period",
    "metric_code",
    "quantity",
    "amount"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/reporting/metrics.schema.json"
}
